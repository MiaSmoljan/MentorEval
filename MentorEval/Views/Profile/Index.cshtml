@model MentorEval.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Moj Profil";
    Layout = null;
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moj Profil - MentorEval</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            padding: 40px 0;
        }
        .profile-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            margin: 0 auto;
        }
        .profile-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .profile-avatar {
            width: 100px;
            height: 100px;
            background: #1a1a2e;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 2.5rem;
            color: white;
        }
        .profile-header h1 {
            color: #1a1a2e;
            font-weight: 700;
            margin-bottom: 5px;
        }
        .profile-role {
            display: inline-block;
            background: #0f3460;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
        }
        .info-group {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .info-label {
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 5px;
        }
        .info-value {
            color: #1a1a2e;
            font-weight: 600;
            font-size: 1.1rem;
        }
        .btn-action {
            border-radius: 10px;
            padding: 12px 25px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-primary-custom {
            background: #1a1a2e;
            border: none;
            color: white;
        }
        .btn-primary-custom:hover {
            background: #0f3460;
            transform: translateY(-2px);
        }
        .btn-outline-custom {
            border: 2px solid #1a1a2e;
            color: #1a1a2e;
            background: transparent;
        }
        .btn-outline-custom:hover {
            background: #1a1a2e;
            color: white;
        }
        .alert {
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="profile-card">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="profile-header">
                <div class="profile-avatar">
                    @Model.FullName.Substring(0, 1).ToUpper()
                </div>
                <h1>@Model.FullName</h1>
                <span class="profile-role">@Model.Role</span>
            </div>

            <div class="info-group">
                <div class="row">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <div class="info-label">Korisničko ime</div>
                        <div class="info-value">@Model.Username</div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-label">ID korisnika</div>
                        <div class="info-value">#@Model.Id</div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-3">
                <a asp-action="ChangePassword" class="btn btn-action btn-primary-custom">
                    🔒 Promijeni lozinku
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-action btn-outline-custom">
                    ← Povratak
                </a>
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-action btn-outline-danger">
                    Odjava
                </a>
            </div>
        </div>
    </div>
</body>
</html>