@model MentorEval.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Promjena lozinke";
    Layout = null;
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Promjena lozinke - MentorEval</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 50px 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 420px;
        }

            .auth-card .logo {
                text-align: center;
                margin-bottom: 30px;
            }

            .auth-card .logo-icon {
                font-size: 3rem;
                margin-bottom: 10px;
            }

            .auth-card h1 {
                color: #1a1a2e;
                font-weight: 700;
                font-size: 1.8rem;
                text-align: center;
                margin-bottom: 30px;
            }

        .form-label {
            color: #1a1a2e;
            font-weight: 600;
        }

        .form-control {
            border-radius: 10px;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            transition: all 0.3s;
        }

            .form-control:focus {
                border-color: #0f3460;
                box-shadow: 0 0 0 3px rgba(15, 52, 96, 0.1);
            }

        .btn-submit {
            background: #1a1a2e;
            border: none;
            padding: 14px;
            font-size: 1.1rem;
            border-radius: 10px;
            width: 100%;
            margin-top: 20px;
            transition: all 0.3s;
            color: white;
        }

            .btn-submit:hover {
                background: #0f3460;
                transform: translateY(-2px);
                color: white;
            }

        .back-link {
            text-align: center;
            margin-top: 20px;
        }

            .back-link a {
                color: #999;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .back-link a:hover {
                    color: #0f3460;
                }

        .alert, .text-danger {
            border-radius: 10px;
        }

        .validation-message {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="logo">
            <div class="logo-icon">🔒</div>
        </div>
        <h1>Promjena lozinke</h1>

        <form method="post" asp-action="ChangePassword" asp-controller="Profile">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Unesite trenutnu lozinku">
                <span asp-validation-for="CurrentPassword" class="validation-message"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Unesite novu lozinku">
                <span asp-validation-for="NewPassword" class="validation-message"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Potvrdite novu lozinku">
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>

            <button type="submit" class="btn btn-submit">Spremi novu lozinku</button>
        </form>

        <div class="back-link">
            <a asp-action="Index" asp-controller="Profile">← Povratak na profil</a>
        </div>
    </div>
</body>
</html>