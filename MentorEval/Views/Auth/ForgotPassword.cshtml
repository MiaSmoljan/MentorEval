@{
    ViewData["Title"] = "Zaboravljena lozinka";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card mt-5">
            <div class="card-header">
                <h4 class="text-center">Zaboravljena lozinka</h4>
            </div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email adresa</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Pošalji link za reset</button>
                </form>

                <hr>
                <p class="text-center">
                    <a asp-action="Login" asp-controller="Auth">← Povratak na prijavu</a>
                </p>
            </div>
        </div>
    </div>
</div>