@{
    ViewData["Title"] = "Dobrodošli";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MentorEval - Sustav za evaluaciju</title>
</head>
<body>
    <div class="welcome-card">
        <div class="logo-icon">🎓</div>
        <h1>MentorEval</h1>
        <p class="subtitle">Sustav za evaluaciju mentora i profesora</p>

        <div class="d-flex flex-column flex-sm-row justify-content-center">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-login">
                Prijava
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-register">
                Registracija
            </a>
        </div>

        <div class="features">
            <div class="feature-item">✓ Anonimne evaluacije</div>
            <div class="feature-item">✓ Jednostavno kreiranje anketa</div>
            <div class="feature-item">✓ Detaljni izvještaji</div>
        </div>
    </div>
</body>
</html>