@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-body">
            <h2>Dobrodošli, @User.Identity.Name! 👋</h2>
            <p class="text-muted">Uspješno ste prijavljeni kao <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></p>

            <hr>

            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger">
                Odjava
            </a>
        </div>
    </div>
</div>
