@{
    ViewData["Title"] = "Dobrodošli";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MentorEval - Sustav za evaluaciju</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .welcome-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 60px 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            text-align: center;
            max-width: 500px;
        }
        .welcome-card h1 {
            color: #1a1a2e;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .welcome-card .subtitle {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 40px;
        }
        .welcome-card .logo-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }
        .btn-login {
            background: #1a1a2e;
            border: none;
            padding: 12px 40px;
            font-size: 1.1rem;
            border-radius: 30px;
            margin: 10px;
            transition: all 0.3s;
        }
        .btn-login:hover {
            background: #0f3460;
            transform: translateY(-2px);
        }
        .btn-register {
            background: transparent;
            border: 2px solid #1a1a2e;
            color: #1a1a2e;
            padding: 12px 40px;
            font-size: 1.1rem;
            border-radius: 30px;
            margin: 10px;
            transition: all 0.3s;
        }
        .btn-register:hover {
            background: #1a1a2e;
            color: white;
            transform: translateY(-2px);
        }
        .features {
            margin-top: 40px;
            padding-top: 30px;
            border-top: 1px solid #eee;
        }
        .feature-item {
            color: #666;
            font-size: 0.95rem;
            margin: 8px 0;
        }
        .feature-item i {
            color: #0f3460;
            margin-right: 8px;
        }
    </style>
</head>
<body>
    <div class="welcome-card">
        <div class="logo-icon">🎓</div>
        <h1>MentorEval</h1>
        <p class="subtitle">Sustav za evaluaciju mentora i profesora</p>

        <div class="d-flex flex-column flex-sm-row justify-content-center">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-login">
                Prijava
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn btn-register">
                Registracija
            </a>
        </div>

        <div class="features">
            <div class="feature-item">✓ Anonimne evaluacije</div>
            <div class="feature-item">✓ Jednostavno kreiranje anketa</div>
            <div class="feature-item">✓ Detaljni izvještaji</div>
        </div>
    </div>
</body>
</html>