@model MentorEval.Models.StudentEvaluationFillViewModel
@{
    ViewData["Title"] = "Ispunjavanje evaluacije";
}

<h2>@Model.CourseName - @Model.Title</h2>
<p class="text-muted">
    Rok: @Model.StartAt.ToString("dd.MM.yyyy") - @Model.EndAt.ToString("dd.MM.yyyy")
</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@err.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Fill" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EvaluationId" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        <div class="card mb-3">
            <div class="card-body">
                <input type="hidden" asp-for="Questions[i].QuestionId" />
                <input type="hidden" asp-for="Questions[i].Type" />
                <input type="hidden" asp-for="Questions[i].Required" />

                <h5 class="card-title">
                    @(i + 1). @Model.Questions[i].Text
                    @if (Model.Questions[i].Required)
                    {
                        <span class="text-danger">*</span>
                    }
                </h5>

                @if (Model.Questions[i].Type == "Scale10")
                {
                    <label class="form-label">Ocjena (1-10)</label>
                    <input class="form-control" type="number" min="1" max="10" asp-for="Questions[i].Grade" />
                }
                else if (Model.Questions[i].Type == "Text")
                {
                    <label class="form-label">Komentar</label>
                    <textarea class="form-control" rows="4" asp-for="Questions[i].AnswerText"></textarea>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Nepoznati tip pitanja: @Model.Questions[i].Type
                    </div>
                }
            </div>
        </div>
    }

    <button class="btn btn-success" type="submit">Pošalji evaluaciju</button>
    <a class="btn btn-secondary" asp-action="Index">Nazad</a>
</form>
