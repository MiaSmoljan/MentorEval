@model IEnumerable<MentorEval.Models.Evaluation>

@{
    ViewData["Title"] = "Evaluations";
    var activeCount = ViewBag.ActiveEvaluationsCount as int? ?? 0;
}

<div class="card-header d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
        <h4 class="mb-0">Available evaluations</h4>
        <span class="badge bg-success">
            Active: @activeCount
        </span>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            Create evaluation!
        </a>
    </div>
</div>


    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-3">
                <em>No evaluations yet. Click “Create evaluation!” to add one.</em>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
            <caption style="display:none">
                Popis dostupnih evaluacija s nazivom, kolegijem, periodom i statusom.
            </caption>
                <thead class="table-light">
                    <tr>
                        <th style="width: 30%;">Eval name</th>
                        <th style="width: 25%;">Course name</th>
                        <th style="width: 25%;">Time period</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 10%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        var isActive = e.Status == "Active";
                        <tr>
                            <td>@e.Title</td>
                            <td>@e.Course?.Name</td>
                            <td>@e.StartAt:d – @e.EndAt:d</td>
                            <td>
                                <span class="badge @(isActive ? "bg-success" : "bg-secondary")">
                                    @e.Status
                                </span>
                            </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">
                                Open
                            </a>

                            <a asp-controller="Reports"
                               asp-action="EvaluationAnalyticsPdf"
                               asp-route-id="@e.Id"
                               class="btn btn-sm btn-danger ms-2"
                               target="_blank">
                                PDF
                            </a>
                        </td>

                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
